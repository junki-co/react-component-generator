{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credential)",
      "Read(**/.credential.*)",
      "Read(**/.credentials)",
      "Read(**/.credentials.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.credential)",
      "Edit(**/.credential.*)",
      "Edit(**/.credentials)",
      "Edit(**/.credentials.*)",
      "Edit(**/*secret*)",
      "Edit(**/*credential*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/.npmrc)",
      "Bash(cat *.env*)",
      "Bash(cat **/.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep * *.env*)",
      "Bash(sed * *.env*)",
      "Bash(awk * *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(cp *.env* *)",
      "Bash(mv *.env* *)",
      "Bash(rm *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(cat *secret*)",
      "Bash(cat *credential*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-test.sh",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-reminder.sh"
          }
        ]
      }
    ]
  }
}
